{
  "name": "ai-business-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Singha Central — business management system (multi-company, event-driven): finance, operations, people, procurement, compliance, fleet and sales.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "secret-scan": "node scripts/secret-scan.mjs",
    "migration-lint": "node scripts/migration-lint.mjs",
    "audit-check": "node scripts/audit-check.mjs",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --status",
    "inventory": "node scripts/completion-inventory.mjs",
    "verify": "npm run secret-scan && npm run migration-lint && node scripts/completion-inventory.mjs --check && node scripts/autonomy/audit-requirements.mjs --quiet && node scripts/autonomy/check-ip-boundary.mjs --quiet && npm run typecheck && npm test",
    "lint": "next lint",
    "autonomy:status": "node scripts/autonomy/check-status.mjs",
    "autonomy:audit": "node scripts/autonomy/audit-requirements.mjs",
    "autonomy:ip-check": "node scripts/autonomy/check-ip-boundary.mjs",
    "autonomy:checkpoint": "npm run autonomy:audit && npm run autonomy:ip-check",
    "browser-check": "node scripts/verify/browser-check.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "decimal.js": "^10.4.3",
    "inngest": "^3.19.0",
    "lucide-react": "^1.28.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "pg": "^8.22.0",
    "playwright-core": "^1.49.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
