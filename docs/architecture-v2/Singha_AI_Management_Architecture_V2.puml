' ============================================================================
' DIAGRAM 5 - END-TO-END EVENT AND MANAGEMENT WORKFLOW
' ============================================================================
@startuml Singha_05_Event_Workflow
title End-to-End Event Processing and Management Workflow

skinparam backgroundColor #FCFCFC
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceArrowThickness 1
skinparam participantBorderColor #6B2823
skinparam participantBackgroundColor #FFF4F2
skinparam databaseBorderColor #6B2823
skinparam databaseBackgroundColor #FFFFFF
skinparam sequenceLifeLineBorderColor #777777

actor "Employee / Customer / Supplier" as Sender
participant "Channel Adapter" as Channel
participant "Verified Ingress" as Ingress
database "Source Event Store" as EventStore
participant "Durable Event Bus" as Bus
participant "Senior AI Manager" as AI
participant "Policy & Approval" as PolicyApproval
participant "Domain Service" as Domain
database "Operational DB / Ledger" as OperationalDB
participant "Notification Outbox" as Notification
actor "Manager / Owner" as Approver

Sender -> Channel : message, document or update
Channel -> Ingress : signed provider webhook
Ingress -> Ingress : verify, normalise, deduplicate
Ingress -> EventStore : persist raw event + correlation ID
EventStore --> Ingress : stored
Ingress -> Bus : enqueue source_event.received
Ingress --> Channel : acknowledge quickly

Bus -> AI : process event with durable retry
AI -> EventStore : load source and related evidence
AI -> AI : classify, resolve entities, extract facts
AI -> AI : assess confidence, risk and impact
AI -> PolicyApproval : structured proposed action

alt Missing or uncertain information
  PolicyApproval --> AI : clarification required
  AI -> Notification : clarification message
  Notification -> Channel : send through outbox
  Channel -> Sender : request missing information
else Sensitive or above authority limit
  PolicyApproval -> Approver : approval request + evidence
  alt Approved
    Approver --> PolicyApproval : approve with conditions
    PolicyApproval -> Domain : authorised command
  else Rejected or expired
    Approver --> PolicyApproval : reject / expire
    PolicyApproval -> Notification : notify requester
  end
else Permitted routine action
  PolicyApproval -> Domain : authorised command
end

Domain -> OperationalDB : transactional state change
OperationalDB --> Domain : committed result
Domain -> EventStore : append audit + outcome event
Domain -> Notification : task, reply or alert
Notification -> Channel : idempotent outbound delivery
Channel -> Sender : outcome / next action

note over Ingress,Bus
  Persist first, acknowledge second, process asynchronously.
end note

note over PolicyApproval,Domain
  Only deterministic domain services mutate business state.
  The language model never writes directly to the ledger or bank.
end note
@enduml


' ============================================================================
' DIAGRAM 6 - EMPLOYEE TASK, CAPACITY AND PROGRESS LIFECYCLE
' ============================================================================
@startuml Singha_06_Task_Lifecycle
title Employee Task, Capacity and Progress Lifecycle

skinparam backgroundColor #FCFCFC
skinparam shadowing false
skinparam defaultFontName Arial
skinparam stateBorderColor #6B2823
skinparam stateBackgroundColor #FFF7F5
skinparam ArrowColor #555555

[*] --> Captured : message / manager / recurring rule / AI plan
Captured --> Clarifying : scope or evidence missing
Clarifying --> Captured : information received
Captured --> Planned : scope, owner criteria and priority set

Planned --> CapacityCheck : candidate assignees identified
CapacityCheck --> WaitingAssignment : insufficient capacity
WaitingAssignment --> CapacityCheck : capacity changed
CapacityCheck --> AwaitingEstimate : worker selected

AwaitingEstimate --> Scheduled : worker accepts estimate and deadline
AwaitingEstimate --> CapacityCheck : worker declines / conflict
Scheduled --> InProgress : work starts
Scheduled --> Overdue : start or due date missed

InProgress --> Blocked : dependency / resource / legal issue
Blocked --> InProgress : blocker resolved
InProgress --> AwaitingEvidence : worker reports completion
InProgress --> Overdue : due date missed

Overdue --> InProgress : recovery plan accepted
Overdue --> Escalated : repeated delay / high impact
Escalated --> CapacityCheck : reassign or add support
Escalated --> InProgress : manager recovery decision

AwaitingEvidence --> Verification : evidence supplied
AwaitingEvidence --> InProgress : insufficient evidence
Verification --> Completed : acceptance criteria satisfied
Verification --> InProgress : correction required
Completed --> [*]

state InProgress {
  [*] --> Working
  Working --> CheckInDue : scheduled follow-up
  CheckInDue --> Working : progress update received
  CheckInDue --> ExceptionReview : no response / risk detected
  ExceptionReview --> Working : plan updated
}

note right of CapacityCheck
  Inputs:
  - contracted hours and work schedule
  - active task estimates
  - skills, role and site availability
  - leave, travel and dependency load
  - priority and authority
end note

note right of Verification
  Evidence may include:
  message confirmation, document, photo,
  approval, system status, GPS/site event
  or financial reconciliation.
end note
@enduml


