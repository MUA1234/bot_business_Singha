' ============================================================================
' DIAGRAM 9 - SECURITY, AUTHORITY AND HUMAN APPROVAL LEVELS
' ============================================================================
@startuml Singha_09_Authority_Levels
title AI Authority Levels and Human Approval Controls

skinparam backgroundColor #FCFCFC
skinparam shadowing false
skinparam defaultFontName Arial
skinparam stateBorderColor #6B2823
skinparam stateBackgroundColor #FFF7F5
skinparam ArrowColor #555555

[*] --> ProposedAction
ProposedAction --> EvidenceCheck

EvidenceCheck --> Clarification : missing / conflicting evidence
Clarification --> EvidenceCheck : corrected information
EvidenceCheck --> RiskClassification : evidence sufficient

RiskClassification --> Automatic : low-risk informational action
RiskClassification --> PolicyControlled : routine action within delegated limit
RiskClassification --> ManagerApproval : operational commitment / exception
RiskClassification --> SpecialistApproval : finance / legal / HR / privacy
RiskClassification --> OwnerApproval : high-value / strategic / irreversible

Automatic --> SchemaValidation
PolicyControlled --> PolicyValidation
PolicyValidation --> SchemaValidation : permitted
PolicyValidation --> ManagerApproval : limit exceeded

ManagerApproval --> SchemaValidation : approved
SpecialistApproval --> SchemaValidation : approved
OwnerApproval --> SchemaValidation : approved

ManagerApproval --> Rejected : rejected / expired
SpecialistApproval --> Rejected : rejected / expired
OwnerApproval --> Rejected : rejected / expired

SchemaValidation --> ActionExecutor
ActionExecutor --> AuditRecorded
Rejected --> AuditRecorded
AuditRecorded --> [*]

note right of Automatic
  Examples:
  reminders, task creation, progress questions,
  summaries and non-sensitive notifications.
end note

note right of SpecialistApproval
  Separate permissions for:
  approve expense, post ledger, initiate payment,
  authorise payment, sign contract, access CCTV.
end note
@enduml


