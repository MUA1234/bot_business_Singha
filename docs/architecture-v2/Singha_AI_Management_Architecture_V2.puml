actor "Auditors / Legal Advisers" as Auditors

rectangle "Singha AI Management Platform" as Platform {
  rectangle "Owner Command Centre" as Command
  rectangle "Senior AI Manager" as AIManager
  rectangle "Department Workspaces" as Workspaces
  rectangle "Accounting & Control Core" as Accounting
  rectangle "Approval & Audit System" as Controls
}

