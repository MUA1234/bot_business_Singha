# .env.example — copy to .env.local and fill in. NEVER commit real values.
# Secrets are server-only unless prefixed NEXT_PUBLIC_ (exposed to the browser bundle —
# keep those non-secret). Production fails fast when a mandatory security setting is
# missing (see src/config/env.ts); development/build may use safe placeholders where no
# real external call is made.

# ---------- App ----------
APP_ENV=development                  # development | staging | production
APP_BASE_URL=http://localhost:3000   # public base URL (used by internal cron fan-out)

# ---------- Supabase (DB + Auth + Storage) ----------
NEXT_PUBLIC_SUPABASE_URL=            # Project URL (safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # anon public key (safe to expose)
SUPABASE_URL=                        # same as NEXT_PUBLIC_SUPABASE_URL (server use)
SUPABASE_SERVICE_ROLE_KEY=           # SECRET — server-only, bypasses RLS. Never client.

# ---------- Database (migrations + integration tests) ----------
DATABASE_URL=                        # Postgres connection string for `npm run migrate`.
                                     #   NON-PRODUCTION only for tests. SSL auto-off for localhost.
TEST_DATABASE_URL=                   # Disposable/non-prod DB for CI integration tests.
# PRODUCTION_DB_HOST=                 # Optional: set in prod env so write/commit tests REFUSE to run there.

# ---------- Feature flags (staged cutover — default OFF = no behaviour change) ----------
RLS_READS=off                        # on = pages read via the authenticated RLS client
RLS_WRITES=off                       # on = writes go through capability RLS / RPCs
WHATSAPP_ASYNC=off                   # on = webhook persists + enqueues; a durable worker replies

# ---------- OpenAI / AI gateway ----------
OPENAI_API_KEY=                      # SECRET. Set a spending limit in the OpenAI dashboard.
OPENAI_PRICE_GPT56_INPUT_PER_MTOK=   # cost accounting: input $ per 1M tokens (decimal)
OPENAI_PRICE_GPT56_OUTPUT_PER_MTOK=  # cost accounting: output $ per 1M tokens (decimal)

# ---------- Inngest (durable jobs + schedules) ----------
INNGEST_EVENT_KEY=                   # SECRET
INNGEST_SIGNING_KEY=                 # SECRET

# ---------- WhatsApp Cloud API (OFFICIAL Meta only) ----------
WHATSAPP_PHONE_NUMBER_ID=            # from Meta WhatsApp API Setup
WHATSAPP_ACCESS_TOKEN=               # SECRET — permanent token via a System User
WHATSAPP_APP_SECRET=                 # SECRET — verifies X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=               # value you choose; must match the webhook config

# ---------- Cron / scheduled jobs ----------
CRON_SECRET=                         # SECRET — Bearer token securing /api/cron/* and /api/health

# ---------- QuickBooks — REMOVED (DECISIONS D-011). Not used; internal Accounting Core is source of truth.
