# .env.example — copy to .env.local and fill in. NEVER commit real values.
# Each variable is obtained via a step in SETUP.md. Secrets are server-only unless
# prefixed NEXT_PUBLIC_ (which are exposed to the browser bundle — keep them non-secret).

# ---------- Supabase (Phase 1) ----------
NEXT_PUBLIC_SUPABASE_URL=            # Project URL (safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # anon public key (safe to expose)
SUPABASE_URL=                        # same as NEXT_PUBLIC_SUPABASE_URL (server use)
SUPABASE_SERVICE_ROLE_KEY=           # SECRET — server-only, bypasses RLS. Never client.

# ---------- OpenAI / AI gateway (Phase 3) ----------
OPENAI_API_KEY=                      # SECRET. Set a spending limit in the OpenAI dashboard.

# ---------- Inngest (Phase 2) ----------
INNGEST_EVENT_KEY=                   # SECRET
INNGEST_SIGNING_KEY=                 # SECRET

# ---------- WhatsApp Cloud API (Phase 8) ----------
WHATSAPP_PHONE_NUMBER_ID=            # from Meta WhatsApp API Setup
WHATSAPP_ACCESS_TOKEN=               # SECRET — permanent token via a System User
WHATSAPP_APP_SECRET=                 # SECRET — used to verify X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=               # value you choose; must match the webhook config

# ---------- QuickBooks — REMOVED (DECISIONS D-011) ----------
# QuickBooks is no longer used. We own the double-entry Accounting Core v0
# (src/accounting/*). No Intuit credentials are required.

# ---------- App ----------
APP_ENV=development                  # development | staging | production
APP_BASE_URL=http://localhost:3000
