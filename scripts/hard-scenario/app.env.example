# The application runtime for the hard-scenario campaign.
#
# `up.mjs` builds the stack — Postgres, GoTrue, two PostgREST instances, the gateway. It does NOT
# start the application, because the application is the thing under test and its configuration is
# part of what the campaign measures. Copy this to `.hard-scenario/app.env` (gitignored), fill in
# the generated values, and start the app with it:
#
#   set -a; . ./.hard-scenario/app.env; set +a
#   NODE_OPTIONS="--require ./scripts/hard-scenario/net-guard.cjs" npx next start -p 3241
#
# Then run `harness-selfcheck.mjs`. It now probes the webhook and cron boundaries from outside and
# FAILS if either answers 500, because 500 means "this route has no configuration" and a campaign
# reading status codes cannot tell that apart from a refusal. Three separate runs were lost to
# exactly that before the check existed: 93 of 120 tests silently skipped, then 11 webhook tests
# failing on 500-instead-of-401, then H5 failing the same way.
#
# Every value here is local and disposable. Nothing hosted is contacted; the net-guard blocks
# outbound DNS and sockets to anything that is not loopback.

APP_ENV=development
APP_BASE_URL=http://127.0.0.1:3241

# ── Supabase, via the campaign gateway (NOT a hosted project) ──────────────────────────────
# The NEXT_PUBLIC_* pair is baked in at BUILD time, so changing them means rebuilding, not just
# restarting. From `.hard-scenario/local-keys.json`, written by up.mjs.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54399
SUPABASE_URL=http://127.0.0.1:54399
NEXT_PUBLIC_SUPABASE_ANON_KEY=<.hard-scenario/local-keys.json .anon>
SUPABASE_SERVICE_ROLE_KEY=<.hard-scenario/local-keys.json .service>

# The campaign's Postgres. Packages E/F and F-004 connect to the database directly to enumerate
# constraints and foreign keys, so without this they fail with ECONNREFUSED on port 5432 and the
# failure looks like a schema defect rather than a missing variable.
DATABASE_URL=postgresql://postgres:<up.mjs password>@127.0.0.1:55442/singha_app

# ── The two boundaries package H and package I exercise ────────────────────────────────────
# These exact values are what `tests/hard-scenario/i-reliability-chaos.test.ts` signs with by
# default; override both there and here together via HST_WHATSAPP_*.
WHATSAPP_APP_SECRET=hst-test-app-secret
WHATSAPP_VERIFY_TOKEN=hst-test-verify-token

# Any value. Its presence is what lets a cron route answer 401 to a caller with no secret instead
# of fail-closing with 500 — H5 asserts the former.
CRON_SECRET=<generate: node -e 'console.log(require("crypto").randomBytes(24).toString("base64url"))'>

# ── Isolation and safety, as the campaign requires them ────────────────────────────────────
# Explicit, not defaulted: `assertProductionConfig` refuses to start in production when either is
# unset, and the campaign should exercise the same database isolation production will run under.
RLS_READS=on
RLS_WRITES=on

# The campaign drives the loop deliberately; an in-process scheduler ticking underneath it would
# make results depend on timing. Model jobs off — no paid model call belongs in a local campaign.
IN_PROCESS_CRON=off
MODEL_JOBS=off

# Execution stays globally disabled. `j-deployed-loop` opens the server-side boundary row itself,
# for the length of one test, and closes it again — which is the point of that suite.
EXECUTION_ENABLED=off
