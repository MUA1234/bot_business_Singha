# Local visual-verification stack — EXAMPLE ONLY.
#
# The authenticated screenshot and layout-audit harnesses need the application
# pointed at a DISPOSABLE local Supabase, never at staging or production.
# Copy this file, fill in the values printed by `supabase status` for your own
# local stack, and source it before starting the server:
#
#   cp scripts/verify/local-stack.env.example .env.verify
#   # paste your own local keys into .env.verify
#   set -a; . ./.env.verify; set +a
#   npx next start -p 3230
#
# .env.verify is gitignored. Do NOT commit real keys, and do NOT point any of
# these at a hosted project — both harnesses refuse a non-loopback host, and
# the fixture seed additionally refuses APP_ENV=production.
#
# The keys a local `supabase start` prints are the framework's well-known
# development keys. They are not secrets, they are not usable anywhere else,
# and they must still never appear in a commit.

APP_ENV=development
APP_BASE_URL=http://127.0.0.1:3230

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local anon key from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<local service_role key from `supabase status`>

# The fixture seed reads these; they must match the two above.
DEV_FIXTURE_SUPABASE_URL=http://127.0.0.1:54321
DEV_FIXTURE_SERVICE_ROLE_KEY=<local service_role key from `supabase status`>

# The password the three fixture accounts are created with. Local only.
DEV_FIXTURE_PASSWORD=<choose any local-only password>

# Left OFF deliberately: the RLS read/write cutover flags. The harness must
# exercise the same default path the application ships with.
# RLS_READS=off
# RLS_WRITES=off
